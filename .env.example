# Gemini API (free tier). Get a key at https://aistudio.google.com/apikey
# Leave unset to run the pipeline in deterministic-only mode (LLM judgment
# is skipped and scoring falls back to the deterministic AI-depth base).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: raises the unauthenticated GitHub API rate limit (60/hr) to
# 5000/hr. Not required -- GitHub enrichment works without it.
GITHUB_TOKEN=
